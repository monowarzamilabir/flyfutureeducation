# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Core ---
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_DOMAIN=localhost:8000
SITE_URL=http://localhost:8000
TIME_ZONE=Asia/Dhaka

# --- Database (PostgreSQL) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=flyfuture
DB_USER=flyfuture
DB_PASSWORD=flyfuture
DB_HOST=localhost
DB_PORT=5432

# --- Email ---
# Dev: leave EMAIL_BACKEND as console backend so mail is printed to the terminal.
# Prod: switch to django.core.mail.backends.smtp.EmailBackend and fill in SMTP creds.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fly Future Education <no-reply@flyfutureeducation.com>
ADMIN_NOTIFICATION_EMAIL=flufutureeducation@gmail.com

# --- reCAPTCHA (optional, TODO: wire in when you have keys) ---
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# --- Amazon S3 / django-storages (optional, off by default) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
